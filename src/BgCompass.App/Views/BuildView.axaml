<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BgCompass.App.ViewModels"
             x:Class="BgCompass.App.Views.BuildView"
             x:DataType="vm:BuildVm">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:CardChipVm">
      <Border Classes="chip" Classes.buy="{Binding InShop}" ToolTip.Tip="{Binding Tip}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="{Binding Name}" />
          <TextBlock Text="{Binding Tier}" Opacity="0.65" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:HintPillVm">
      <Border Classes="pill" ToolTip.Tip="{Binding Tip}">
        <TextBlock Text="{Binding Label}" Classes.coral="{Binding IsAlert}" Classes.dim="{Binding !IsAlert}" />
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>
  <StackPanel>
    <TextBlock Text="{Binding Empty}" Classes="dim" IsVisible="{Binding HasEmpty}" />
    <StackPanel IsVisible="{Binding HasData}">
      <ItemsControl ItemsSource="{Binding Stats}" IsVisible="{Binding HasStats}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TurnStat">
          <Border Classes="fieldstat panelstat" Classes.accent="{Binding Accent}" Classes.alert="{Binding Alert}" Classes.old="{Binding Muted}" ToolTip.Tip="{Binding Tip}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Value}" Classes="value" />
              <TextBlock Text="{Binding Caption}" Classes="caption" />
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Брать сейчас" Classes="small dim" Margin="0,0,0,4" IsVisible="{Binding HasBuy}" />
      <ItemsControl ItemsSource="{Binding Buy}" IsVisible="{Binding HasBuy}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Directions}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DirectionVm">
          <StackPanel Margin="0,0,0,4">
            <Button Classes="row" Classes.sel="{Binding Expanded}" Command="{Binding Toggle}" ToolTip.Tip="{Binding Tip}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Classes="tile outline" Classes.lime="{Binding IsClear}"><TextBlock Text="{Binding Percent}" /></Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="bold" MaxLines="2" Margin="10,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel IsVisible="{Binding Expanded}" Margin="4,6,0,4">
              <TextBlock Text="Нужно" Classes="small dim" Margin="0,0,0,4" IsVisible="{Binding HasNeed}" />
              <ItemsControl ItemsSource="{Binding Need}" IsVisible="{Binding HasNeed}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Следующая таверна" Classes="small dim" Margin="0,4,0,4" IsVisible="{Binding HasNext}" />
              <ItemsControl ItemsSource="{Binding Next}" IsVisible="{Binding HasNext}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Hints}" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
