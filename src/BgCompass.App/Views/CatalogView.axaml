<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BgCompass.App.ViewModels"
             xmlns:v="using:BgCompass.App.Views"
             x:Class="BgCompass.App.Views.CatalogView"
             x:DataType="vm:CatalogVm">
  <Grid RowDefinitions="Auto,*" Margin="20,6,20,12">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
      <TextBox Text="{Binding Search}" PlaceholderText="Поиск" MinWidth="140" Margin="0,0,8,0" VerticalContentAlignment="Center"
               ToolTip.Tip="По названию и тексту карты, по-русски или по-английски" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" Width="116" Margin="0,0,6,0" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding TribeOptions}" SelectedItem="{Binding Tribe}" Width="136" Margin="0,0,6,0" />
      <ComboBox Grid.Column="3" ItemsSource="{Binding KeywordOptions}" SelectedItem="{Binding Keyword}" Width="136" Margin="0,0,6,0" />
      <ComboBox Grid.Column="4" ItemsSource="{Binding Lobbies}" SelectedItem="{Binding Lobby}" Width="140" Margin="0,0,8,0"
                ToolTip.Tip="Статус племени в текущем лобби" />
      <Button Grid.Column="5" Content="Сброс" Command="{Binding Clear}" />
      <TextBlock Grid.Column="6" Text="{Binding Count}" Classes="dim small" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="56" />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Empty}" Classes="dim" IsVisible="{Binding HasEmpty}" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" IsVisible="{Binding !HasEmpty}" Background="Transparent" Padding="0">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0,1" /><Setter Property="MinHeight" Value="0" /></Style></ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CatalogItemVm">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2" Background="Transparent" ToolTip.Tip="{Binding Tip}">
            <Border Classes="tile" Classes.lime="{Binding InLobby}">
              <TextBlock Text="{Binding Tier}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Classes="bold one" />
                <TextBlock Text="{Binding Tribes}" Classes="dim small one" VerticalAlignment="Center" />
                <TextBlock Text="в лобби" Classes="accent small one" VerticalAlignment="Center" IsVisible="{Binding InLobby}" />
              </StackPanel>
              <TextBlock Text="{Binding Line}" Classes="dim small one" />
            </StackPanel>
            <Border Grid.Column="2" Width="96" Height="28" CornerRadius="{StaticResource RadiusSmall}" ClipToBounds="True" Margin="12,0">
              <v:ArtImage CardId="{Binding Id}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding Stats}" Classes="bold dim" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,16,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
