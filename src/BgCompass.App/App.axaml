<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BgCompass.App.ViewModels"
             xmlns:v="using:BgCompass.App.Views"
             x:Class="BgCompass.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BgCompass/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://BgCompass/Theme/Styles.axaml" />
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TopBarVm"><v:TribesView /></DataTemplate>
    <DataTemplate DataType="vm:StatusVm"><v:StatusView /></DataTemplate>
    <DataTemplate DataType="vm:HeroVm"><v:HeroView /></DataTemplate>
    <DataTemplate DataType="vm:BuildVm"><v:BuildView /></DataTemplate>
    <DataTemplate DataType="vm:OpponentVm"><v:OpponentView /></DataTemplate>
    <DataTemplate DataType="vm:SimVm"><v:SimPanelView /></DataTemplate>
    <DataTemplate DataType="vm:GameOverVm"><v:GameOverView /></DataTemplate>
  </Application.DataTemplates>
</Application>
