<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The only place that names colours. Cool ink against the game's warm browns; lime means "good / do this", coral means "bad". -->
  <Color x:Key="SurfaceColor">#F2101820</Color>
  <Color x:Key="SurfaceSolidColor">#FF101820</Color>
  <Color x:Key="RaisedColor">#FF1C2732</Color>
  <Color x:Key="HoverColor">#FF263441</Color>
  <Color x:Key="LineColor">#FF2C3A47</Color>
  <Color x:Key="EdgeColor">#26FFFFFF</Color>
  <Color x:Key="TextColor">#FFF1F5F8</Color>
  <Color x:Key="TextDimColor">#FF97A6B4</Color>
  <Color x:Key="InkColor">#FF101820</Color>
  <Color x:Key="AccentColor">#FFD2F24A</Color>
  <Color x:Key="LossColor">#FFFF7D6B</Color>
  <Color x:Key="TieColor">#FF6F8192</Color>
  <Color x:Key="WarnColor">#FFFFC24D</Color>
  <!-- Fluent reads these for sliders, checkboxes and focus. -->
  <Color x:Key="SystemAccentColor">#FFD2F24A</Color>
  <Color x:Key="SystemAccentColorDark1">#FFB5D230</Color>
  <Color x:Key="SystemAccentColorLight1">#FFE0F77F</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSolidBrush" Color="{StaticResource SurfaceSolidColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="WinBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="TieBrush" Color="{StaticResource TieColor}" />
  <SolidColorBrush x:Key="LossBrush" Color="{StaticResource LossColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />

  <x:Double x:Key="FontBody">13</x:Double>
  <x:Double x:Key="FontSmall">12</x:Double>
  <x:Double x:Key="FontTiny">11</x:Double>
  <x:Double x:Key="FontTitle">15</x:Double>
  <x:Double x:Key="FontBig">28</x:Double>
  <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
  <CornerRadius x:Key="Radius">8</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <FontFamily x:Key="UiFont">avares://BgCompass/Assets/Fonts#Onest, Segoe UI, sans-serif</FontFamily>

  <!-- Stroke icons on a 16x16 grid, drawn by Path.icon. -->
  <StreamGeometry x:Key="IconWindow">M2.5 4 H13.5 V12.5 H2.5 Z M2.5 6.5 H13.5</StreamGeometry>
  <StreamGeometry x:Key="IconChevronUp">M4 10 L8 6 L12 10</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M4 6 L8 10 L12 6</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M4 4 L12 12 M12 4 L4 12</StreamGeometry>
  <StreamGeometry x:Key="IconUpdate">M8 2.5 V10 M4.5 7 L8 10.5 L11.5 7 M3 13.5 H13</StreamGeometry>
</ResourceDictionary>
